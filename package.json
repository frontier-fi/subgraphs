{
  "name": "balancer-v3-subgraphs",
  "private": true,
  "scripts": {
    "generate-manifests": "node scripts/generate-manifests.js",
    "pools": "pnpm --filter @subgraphs/pools",
    "vault": "pnpm --filter @subgraphs/vault",
    "codegen": "pnpm -r codegen subgraph.sepolia.yaml",
    "build:all": "bash scripts/build-all.sh",
    "test": "vitest run",
    "test:fidelity": "vitest run tests/fidelity",
    "test:watch": "vitest",
    "reconcile": "node scripts/reconcile.mjs"
  },
  "prettier": {
    "trailingComma": "es5"
  },
  "devDependencies": {
    "viem": "2.57.19",
    "vitest": "3.2.4"
  }
}
